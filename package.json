{
  "name": "bundle-forensics",
  "version": "0.1.0",
  "description": "Explain a JavaScript bundle: which import pulled in what, which dependencies are duplicated, and what changed between two builds.",
  "keywords": [
    "bundle",
    "esbuild",
    "metafile",
    "webpack",
    "bundle-size",
    "duplicate-dependencies",
    "bundle-analyzer"
  ],
  "license": "MIT",
  "author": "Prabesh Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellpuffyt/bundle-forensics.git"
  },
  "homepage": "https://github.com/hellpuffyt/bundle-forensics#readme",
  "bugs": {
    "url": "https://github.com/hellpuffyt/bundle-forensics/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bundle-forensics": "bin/bundle-forensics.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.16.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
